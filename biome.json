{
	"$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"css": {
		"linter": { "enabled": false },
		"formatter": { "enabled": false },
		"assist": { "enabled": false }
	},
	"files": {
		"ignoreUnknown": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true
	},
	"overrides": [
		{
			"includes": ["src/components/ui/**/*.tsx", "src/routeTree.gen.ts"],
			"linter": { "enabled": false },
			"formatter": { "enabled": false }
		}
	]
}
